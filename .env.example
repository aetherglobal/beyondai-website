DATABASE_URL=postgres://localhost:5432/beyond_ai

PAYLOAD_SECRET=YOUR_SECRET_HERE
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE

MAILCHIMP_API_KEY=YOUR_MAILCHIMP_API_KEY_HERE
MAILCHIMP_SERVER_PREFIX=YOUR_MAILCHIMP_SERVER_PREFIX_HERE
MAILCHIMP_AUDIENCE_ID=YOUR_MAILCHIMP_AUDIENCE_ID_HERE

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

S3_BUCKET=beyondai-media
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
S3_PUBLIC_URL=https://your-distribution.cloudfront.net

# Email ------------------------------------------------------------------------
# Without SMTP_HOST, Payload falls back to an adapter that resolves and sends nothing:
# password resets and form notifications fail silently. Any SMTP provider works
# (Resend, SES, Postmark, Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=info@beyondai.africa
SMTP_FROM_NAME=Beyond AI

SUBMISSION_NOTIFICATION_EMAIL=info@beyondai.africa

SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn_here
SENTRY_ORG=your_org_here
SENTRY_PROJECT=your_project_here
SENTRY_AUTH_TOKEN=your_auth_token_here
