    "framer-motion": "^12.43.0",
    "graphql": "^16.14.2",
    "lucide-react": "0.563.0",
    "next": "16.3.5",
    "payload": "3.83.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "yet-another-react-lightbox": "^3.32.2"
